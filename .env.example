# Copy this file to .env.local and fill in your own values.
# Never commit real keys. Only VITE_* variables are bundled into the app and
# are visible to anyone who downloads it, so only put public values here.

# Supabase project URL (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key — public by design, protected by Row Level Security.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-key
